# Klucz OpenRouter używany wyłącznie na serwerze, także dla obrazów i głosu.
OPENROUTER_API_KEY=
# Model rozmowy, analizy JSON i vision — wpisz swój obecny identyfikator.
OPENROUTER_MODEL=

# Dodatkowe modele (opcjonalne; poniżej domyślne ustawienia aplikacji).
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
# Model TTS musi obsługiwać API /audio/speech, MP3 i polski.
OPENROUTER_SPEECH_MODEL=elevenlabs/eleven-flash-v2.5
# Żeński głos Sarah; nazwa głosu musi pasować do wybranego modelu TTS.
OPENROUTER_SPEECH_VOICE=sarah

CHAT_PASSWORD=
SESSION_SECRET=
